{
  "hosts": [
    { "host": "api.elevenlabs.io", "credential": { "account": "ELEVENLABS_API_KEY", "header": "xi-api-key", "format": "{value}" } },
    { "host": "api.githubcopilot.com", "credential": { "account": "INTEGRATION_GITHUB_TOKEN", "header": "authorization", "format": "Bearer {value}" } },
    { "host": "api.notion.com" },
    { "host": "api.search.brave.com" },
    { "host": "api.telegram.org" },
    { "host": "context7.com" },
    { "host": "huggingface.co" },
    { "host": "mcp.kite.trade" },
    { "host": "mcp.nseindia.in" },
    { "host": "mcp.tavily.com", "credential": { "account": "INTEGRATION_TAVILY_APIKEY", "header": "authorization", "format": "Bearer {value}" } },
    { "host": "registry.npmjs.org" }
  ],
  "servers": {
    "brave-search": { "hosts": ["api.search.brave.com"], "env": { "BRAVE_API_KEY": "INTEGRATION_BRAVE_SEARCH_APIKEY" } },
    "context7": { "hosts": ["context7.com"], "env": { "CONTEXT7_API_KEY": "INTEGRATION_CONTEXT7_APIKEY" } },
    "notion": { "hosts": ["api.notion.com"], "env": { "NOTION_TOKEN": "INTEGRATION_NOTION_TOKEN" } }
  }
}
