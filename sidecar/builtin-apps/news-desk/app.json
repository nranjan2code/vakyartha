{
  "id": "news-desk",
  "version": "2.0.1",
  "name": "News Desk",
  "description": "Categorized publisher feeds, exact source links, a persistent reading list and transparent refresh receipts.",
  "author": "Vakyartha",
  "icon": "page",
  "category": "productivity",
  "entrypoints": {
    "backend": "server.ts",
    "surface": "surface.json"
  },
  "runtime": {
    "engine": "node24",
    "memoryLimitMb": 256,
    "cpuTimeLimitSec": 30,
    "maxStorageMb": 16
  },
  "entitlements": {
    "network": {
      "mode": "brokered",
      "allowedDomains": []
    },
    "mcpTools": [
      "web__fetch_page"
    ],
    "storage": {
      "sqlite": false,
      "duckdb": false
    }
  },
  "triggers": [
    {
      "id": "refresh-sources",
      "kind": "cron",
      "expression": "*/15 * * * *",
      "action": "refresh",
      "maxDurationSec": 30
    }
  ]
}
