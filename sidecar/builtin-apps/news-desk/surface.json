[
  {
    "id": "headlines",
    "title": "Headlines",
    "data": {
      "category": "All",
      "categoryOptions": [
        {
          "label": "All categories",
          "value": "All"
        },
        {
          "label": "Business",
          "value": "Business"
        },
        {
          "label": "Science",
          "value": "Science"
        },
        {
          "label": "Technology",
          "value": "Technology"
        },
        {
          "label": "World",
          "value": "World"
        }
      ],
      "emptyHint": "In Settings → Integrations, enable Web pages and set fetch_page to Allow. Then press Refresh to read your 4 feeds; headlines appear here, newest first, with links to the originals."
    },
    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "news-bar",
          "news-empty"
        ]
      },
      {
        "id": "news-bar",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "category",
          "refresh"
        ]
      },
      {
        "id": "category",
        "type": "select",
        "props": {
          "label": "Category",
          "bind": "/category",
          "options": "{/categoryOptions}"
        }
      },
      {
        "id": "refresh",
        "type": "button",
        "props": {
          "label": "Refresh",
          "action": "refresh",
          "style": "primary"
        }
      },
      {
        "id": "news-empty",
        "type": "card",
        "props": {
          "title": "No headlines yet",
          "body": "{/emptyHint}"
        },
        "children": [
          "news-sources"
        ]
      },
      {
        "id": "news-sources",
        "type": "button",
        "props": {
          "label": "Review feeds",
          "action": "show_sources",
          "style": "link"
        }
      }
    ]
  },
  {
    "id": "saved",
    "title": "Reading list",
    "data": {},
    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "saved-empty"
        ]
      },
      {
        "id": "saved-empty",
        "type": "text",
        "props": {
          "content": "Articles you save from Headlines stay here, even after they leave the feed.",
          "variant": "caption"
        }
      }
    ]
  },
  {
    "id": "sources",
    "title": "Sources",
    "data": {
      "feedsTitle": "Feeds · 4 of 6",
      "feeds": [
        {
          "name": "BBC World",
          "category": "World",
          "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
          "removable": true
        },
        {
          "name": "BBC Business",
          "category": "Business",
          "url": "https://feeds.bbci.co.uk/news/business/rss.xml",
          "removable": true
        },
        {
          "name": "BBC Technology",
          "category": "Technology",
          "url": "https://feeds.bbci.co.uk/news/technology/rss.xml",
          "removable": true
        },
        {
          "name": "BBC Science",
          "category": "Science",
          "url": "https://feeds.bbci.co.uk/news/science_and_environment/rss.xml",
          "removable": true
        }
      ],
      "newFeed": {
        "name": "",
        "category": "",
        "url": ""
      }
    },
    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "feeds-section",
          "ledger-section"
        ]
      },
      {
        "id": "feeds-section",
        "type": "section",
        "props": {
          "title": "{/feedsTitle}",
          "description": "Publisher RSS, Atom or JSON feeds over HTTPS. Names and categories are your labels."
        },
        "children": [
          "feeds",
          "add-feed"
        ]
      },
      {
        "id": "feeds",
        "type": "grid",
        "props": {
          "columns": 2,
          "minItemWidth": "md",
          "gap": "sm"
        },
        "children": {
          "each": "/feeds",
          "template": "feed-card"
        }
      },
      {
        "id": "feed-card",
        "type": "card",
        "props": {
          "title": "{name}",
          "subtitle": "{category}",
          "body": "{url}"
        },
        "children": [
          "feed-remove"
        ]
      },
      {
        "id": "feed-remove",
        "type": "button",
        "props": {
          "label": "Remove",
          "action": "remove_feed",
          "payload": {
            "id": "{url}"
          },
          "style": "link",
          "visibleIf": "{removable}"
        }
      },
      {
        "id": "add-feed",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "feed-name",
          "feed-category",
          "feed-url",
          "feed-add"
        ]
      },
      {
        "id": "feed-name",
        "type": "input",
        "props": {
          "label": "Name",
          "bind": "/newFeed/name",
          "placeholder": "Publisher"
        }
      },
      {
        "id": "feed-category",
        "type": "input",
        "props": {
          "label": "Category",
          "bind": "/newFeed/category",
          "placeholder": "World"
        }
      },
      {
        "id": "feed-url",
        "type": "input",
        "props": {
          "label": "Feed URL",
          "bind": "/newFeed/url",
          "placeholder": "https://…/rss.xml"
        }
      },
      {
        "id": "feed-add",
        "type": "button",
        "props": {
          "label": "Add feed",
          "action": "add_feed",
          "style": "secondary"
        }
      },
      {
        "id": "ledger-section",
        "type": "section",
        "props": {
          "title": "Source ledger",
          "description": "The latest 24 reads. A scheduled refresh (off until you enable it under Manage) runs every 15 minutes while the app and computer are awake."
        },
        "children": [
          "no-receipts"
        ]
      },
      {
        "id": "no-receipts",
        "type": "text",
        "props": {
          "content": "Nothing read yet. In Settings → Integrations, enable Web pages and set fetch_page to Allow.",
          "variant": "caption"
        }
      }
    ]
  }
]
