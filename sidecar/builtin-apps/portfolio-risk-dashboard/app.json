{
  "$schema": "https://vakyartha.dev/schemas/app-manifest.v1.json",
  "id": "portfolio-risk-dashboard",
  "version": "1.0.0",
  "name": "Live Portfolio & Risk Dashboard",
  "description": "Dynamic financial workbench calculating parametric Value-at-Risk (VaR), Sharpe ratios, and asset allocation models in real-time.",
  "author": "Vakyartha Team",
  "category": "finance",
  "icon": "chart-pie",
  "entrypoints": {
    "backend": "server.ts",
    "surface": "surface.json"
  },
  "runtime": {
    "engine": "node24",
    "memoryLimitMb": 256,
    "cpuTimeLimitSec": 60,
    "maxStorageMb": 512
  },
  "entitlements": {
    "network": {
      "mode": "airgap",
      "allowedDomains": []
    },
    "mcpTools": [],
    "storage": {
      "sqlite": false,
      "duckdb": false
    }
  },
  "triggers": [
    {
      "id": "recalculate-risk",
      "kind": "cron",
      "expression": "*/5 * * * *",
      "action": "recalculateMetrics",
      "maxDurationSec": 30
    }
  ]
}

