      "notes": [
        {
          "id": "note-1",
          "title": "Welcome to Voice Desk",
          "tags": "#voice #notes",
          "updatedAt": "2026-10-30"
        }
      ],
      "activeTitle": "Welcome to Voice Desk",
      "activeTags": "#voice #notes",
      "activeContent": "Welcome to Voice Desk.\n\nSpeak naturally via dictation (⌘D) or type your thoughts directly. Verbal fillers ('um', 'ah') and self-corrections are cleaned up using the active model.",
      "activeRaw": "Uh, hello and welcome to Voice Desk. You can, um, speak your thoughts or type them.",
      "newNoteTitle": "",
      "newActionText": "",
      "newActionOwner": "",
      "actions": [
        {
          "id": "act-1",
          "task": "Try dictating a note with ⌘D",
          "owner": "You",
          "status": "To Do"
        },
        {
          "id": "act-2",
          "task": "Type edits in the note content editor",
          "owner": "You",
          "status": "Done"
        }
      ],
      "decisions": [
        {
          "id": "dec-1",
          "decision": "Voice Desk stores notes locally with zero network leakage",
          "date": "2026-10-30"
        }
      ]
    },
    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "voice-studio-dock",
          "editor-split"
        ]
      },
      {
        "id": "voice-studio-dock",
        "type": "card",
        "props": {
          "title": "🎙️ Voice Studio Dock",
          "subtitle": "{/statusMessage}",
          "tone": "info"
        },
        "children": [
          "voice-actions-row"
        ]
      },
      {
        "id": "voice-actions-row",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm"
        },
        "children": [
          "btn-dictate",
          "btn-save",
          "btn-clean",
          "btn-read",
          "btn-export"
        ]
      },
      {
        "id": "btn-dictate",
        "type": "button",
        "props": {
          "label": "🎙️ Dictate Note (⌘D)",
          "action": "dictate_note",
          "style": "primary"
        }
      },
      {
        "id": "btn-save",
        "type": "button",
        "props": {
          "label": "💾 Save Changes",
          "action": "save_note",
          "style": "primary"
        }
      },
      {
        "id": "btn-clean",
        "type": "button",
        "props": {
          "label": "✨ Polish Content",
          "action": "clean_note",
          "style": "secondary"
        }
      },
      {
        "id": "btn-read",
        "type": "button",
        "props": {
          "label": "🔊 Read Aloud",
          "action": "read_note",
          "style": "secondary"
        }
      },
      {
        "id": "btn-export",
        "type": "button",
        "props": {
          "label": "📥 Export Markdown",
          "action": "export_markdown",
          "style": "secondary"
        }
      },
      {
        "id": "editor-split",
        "type": "split",
        "props": {
          "ratio": "1:2",
          "gap": "md"
        },
        "children": [
          "pane-notes-sidebar",
          "pane-editor"
        ]
      },
      {
        "id": "pane-notes-sidebar",
        "type": "stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "heading-library",
          "select-active-note",
          "new-note-form",
          "active-note-card",
          "notes-summary-stats"
        ]
      },
      {
        "id": "heading-library",
        "type": "text",
        "props": {
          "content": "### 📚 Notes Library",
          "variant": "subheading"
        }
      },
      {
        "id": "select-active-note",
        "type": "select",
        "props": {
          "label": "Open Note",
          "bind": "/selectedNoteId",
          "options": "{/noteOptions}"
        }
      },
      {
        "id": "new-note-form",
        "type": "form",
        "props": {
          "submit": "create_note",
          "submitLabel": "+ Create Note"
        },
        "children": [
          "input-new-title"
        ]
      },
      {
        "id": "input-new-title",
        "type": "input",
        "props": {
          "label": "New Note Title",
          "bind": "/newNoteTitle",
          "placeholder": "e.g. Brainstorm, Meeting..."
        }
      },
      {
        "id": "active-note-card",
        "type": "card",
        "props": {
          "title": "{/activeTitle}",
          "subtitle": "Last edited: {/noteDate} · {/activeTags}",
          "body": "{/activeExcerpt}"
        },
        "children": [
          "btn-delete-active"
        ]
      },
      {
        "id": "btn-delete-active",
        "type": "button",
        "props": {
          "label": "🗑️ Delete Note",
          "action": "delete_note",
          "style": "danger"
        }
      },
      {
        "id": "notes-summary-stats",
        "type": "grid",
        "props": {
          "columns": 2,
          "minItemWidth": "sm",
          "gap": "sm"
        },
        "children": [
          "stat-notes",
          "stat-actions"
        ]
      },
      {
        "id": "stat-notes",
        "type": "stat",
        "props": {
          "label": "Notes in Library",
          "value": "{/noteCount}"
        }
      },
      {
        "id": "stat-actions",
        "type": "stat",
        "props": {
          "label": "Pending Tasks",
          "value": "{/actionCount}"
        }
      },
      {
        "id": "pane-editor",
        "type": "stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "heading-editor",
          "active-form",
          "card-deliverables",
          "card-raw-audio"
        ]
      },
      {
        "id": "heading-editor",
        "type": "text",
        "props": {
          "content": "### ✍️ Note Document",
          "variant": "subheading"
        }
      },
      {
        "id": "active-form",
        "type": "form",
        "props": {
          "submit": "save_note",
          "submitLabel": "💾 Save Changes"
        },
        "children": [
          "editor-meta-grid",
          "textarea-active-content"
        ]
      },
      {
        "id": "editor-meta-grid",
        "type": "grid",
        "props": {
          "columns": 2,
          "minItemWidth": "sm",
          "gap": "md"
        },
        "children": [
          "input-active-title",
          "input-active-tags"
        ]
      },
      {
        "id": "input-active-title",
        "type": "input",
        "props": {
          "label": "Note Title",
          "bind": "/activeTitle",
          "placeholder": "Document title..."
        }
      },
      {
        "id": "input-active-tags",
        "type": "input",
        "props": {
          "label": "Topic Tags",
          "bind": "/activeTags",
          "placeholder": "#voice #strategy..."
        }
      },
      {
        "id": "textarea-active-content",
        "type": "textarea",
        "props": {
          "label": "Note Body (Markdown formatting, bullets and paragraphs supported)",
          "bind": "/activeContent",
          "placeholder": "Speak with ⌘D or start typing your thoughts here..."
        }
      },
      {
        "id": "card-deliverables",
        "type": "card",
        "props": {
          "title": "✅ Action Items & Deliverables",
          "subtitle": "Tasks extracted from speech or added manually"
        },
        "children": [
          "actions-table",
          "action-add-form"
        ]
      },
      {
        "id": "actions-table",
        "type": "table",
        "props": {
          "columns": [
            {
              "key": "task",
              "label": "Task Description"
            },
            {
              "key": "owner",
              "label": "Assignee"
            },
            {
              "key": "status",
              "label": "Status"
            }
          ],
          "rows": "{/actions}",
          "sortable": true,
          "searchable": true,
          "pageSize": 5
        }
      },
      {
        "id": "action-add-form",
        "type": "form",
        "props": {
          "submit": "add_action",
          "submitLabel": "+ Add Action"
        },
        "children": [
          "action-add-grid"
        ]
      },
      {
        "id": "action-add-grid",
        "type": "grid",
        "props": {
          "columns": 2,
          "minItemWidth": "sm",
          "gap": "sm"
        },
        "children": [
          "input-new-action-task",
          "input-new-action-owner"
        ]
      },
      {
        "id": "input-new-action-task",
        "type": "input",
        "props": {
          "label": "New Action Task",
          "bind": "/newActionText",
          "placeholder": "e.g. Schedule review meeting..."
        }
      },
      {
        "id": "input-new-action-owner",
        "type": "input",
        "props": {
          "label": "Assignee",
          "bind": "/newActionOwner",
          "placeholder": "e.g. You, Alex..."
        }
      },
      {
        "id": "card-raw-audio",
        "type": "card",
        "props": {
          "title": "🎙️ Original Audio Transcript (Verbatim Memory)",
          "subtitle": "Raw speech captured before speech-to-text normalizer",
          "body": "{/activeRaw}",
          "tone": "neutral"
        }
      }
    ]
  },
